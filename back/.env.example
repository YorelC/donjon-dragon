# MongoDB connection string
# Default: mongodb://localhost:27017/donjon-dragon
MONGODB_URI=mongodb://localhost:27017/donjon-dragon

# JWT secret for signing access and refresh tokens
# Change this to a strong secret in production
JWT_SECRET=dev-secret-change-in-production

# Gmail account for sending verification emails
# Use an App Password (not your main Gmail password)
EMAIL_USER=your-email@gmail.com
EMAIL_APP_PASSWORD=your-app-password-here
