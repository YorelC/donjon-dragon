# Toutes ces variables sont validees par Zod au demarrage
# (back/src/config/env.validation.ts). Une variable manquante ou invalide fait
# echouer le boot immediatement, avec le detail des champs en cause.

# Port d'ecoute de l'API (defaut: 3000)
PORT=3000

# Chaine de connexion MongoDB — requis.
# Le replica set n'est PAS optionnel : les ecritures d'amitie et de campagne
# posent l'etat et l'outbox dans une meme transaction, et Mongo refuse toute
# transaction sur une instance autonome. `docker-compose up mongo` demarre le
# replica set attendu.
MONGODB_URI=mongodb://localhost:27017/donjon-dragon?replicaSet=donjonDragon&directConnection=true

# Secret de signature des access tokens — requis, 32 caracteres minimum.
# Il n'y a AUCUNE valeur par defaut : c'est volontaire. Genere le tien avec
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Duree de vie de l'access token, format ms/zeit (defaut: 15m)
ACCESS_TOKEN_TTL=15m

# Cout du hash bcrypt, entre 10 et 15 (defaut: 12)
BCRYPT_ROUNDS=12

# Garde-fou global de debit. Les routes /auth/* ont leur propre limite, bien
# plus serree, definie dans le code (constante de securite, pas de deploiement).
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=300

# Compte Gmail d'envoi des emails de verification — requis.
# Utiliser un App Password, pas le mot de passe du compte.
EMAIL_USER=your-email@gmail.com
EMAIL_APP_PASSWORD=your-app-password-here

# development | test | production  (defaut: development)
# En production, les cookies de session passent en `secure` : HTTPS uniquement.
NODE_ENV=development

# Origines autorisees par CORS, separees par des virgules
# (defaut: http://localhost:5173). Une LISTE et non un joker : le navigateur
# refuse Access-Control-Allow-Origin: * des que les credentials sont actives.
CORS_ORIGINS=http://localhost:5173
