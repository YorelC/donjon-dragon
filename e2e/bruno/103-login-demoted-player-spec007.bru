meta {
  name: 104 - Login demoted player Spec 007
  type: http
  seq: 104
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

headers {
  content-type: application/json
}
body:json {
  {
    "email": "{{ownerEmail}}",
    "password": "{{ownerPassword}}"
  }
}

script:post-response {
  bru.setVar('csrfToken', bru.cookies.get('csrf_token'));
}

tests {
  test('ouvre la session du joueur rétrogradé', function() {
    expect(res.getStatus()).to.equal(201);
  });
}
