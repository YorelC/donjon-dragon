meta {
  name: 06 - List owner campaigns
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/campaigns
  body: none
  auth: none
}

tests {
  test('ne contient qu’une occurrence de la campagne créée', function() {
    const matches = res.getBody().filter(
      (campaign) => campaign.id === bru.getVar('campaignId'),
    );
    expect(res.getStatus()).to.equal(200);
    expect(matches).to.have.lengthOf(1);
  });
}
