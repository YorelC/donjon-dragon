auth {
  mode: none
}

script:pre-request {
  const keys = [
    'creationKey',
    'firstInviteKey',
    'thirdAcceptKey',
    'firstAcceptKey',
    'secondInviteKey',
    'secondRefuseKey',
    'thirdInviteKey',
    'thirdCancelKey',
    'permissionInviteKey',
    'promoteFrodoKey',
    'permissionCancelKey',
    'demoteFrodoKey',
    'forbiddenInviteKey',
    'lastGameMasterKey',
    'finalLegolasInviteKey',
    'finalLegolasAcceptKey',
    'promoteLegolasKey',
    'transferToLegolasKey',
    'transferBackKey',
    'ownerLeaveKey',
    'excludeFrodoKey',
    'inviteGandalfKey',
    'acceptGandalfKey',
    'unauthorizedExcludeKey',
    'promoteGandalfKey',
    'demoteLegolasKey',
    'lastGameMasterExclusionKey',
    'promoteLegolasAgainKey',
    'excludeGandalfKey',
    'replacementKey',
    'missingCampaignId',
    'rollCampaignKey',
    'rollOtherCampaignKey',
    'firstAbilityRollKey',
    'rolledCharacterKey',
  ];
  keys.forEach((key) => {
    if (!bru.hasVar(key)) bru.setVar(key, bru.interpolate('{{$randomUUID}}'));
  });
}
