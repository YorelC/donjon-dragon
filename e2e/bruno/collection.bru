auth {
  mode: none
}

script:pre-request {
  const keys = [
    'creationKey',
    'firstInviteKey',
    'thirdAcceptKey',
    'firstAcceptKey',
    'secondInviteKey',
    'secondRefuseKey',
    'thirdInviteKey',
    'thirdCancelKey',
  ];
  keys.forEach((key) => {
    if (!bru.hasVar(key)) bru.setVar(key, bru.interpolate('{{$randomUUID}}'));
  });
}
