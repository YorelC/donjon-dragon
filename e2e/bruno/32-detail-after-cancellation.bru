meta {
  name: 32 - Detail after cancellation
  type: http
  seq: 32
}

get {
  url: {{baseUrl}}/campaigns/{{campaignId}}
  body: none
  auth: none
}

script:post-response {
  bru.setVar('campaignRevision', res.getBody().revision);
}

tests {
  test('ne projette plus aucune invitation ouverte', function() {
    const legolasMemberships = res.getBody().players.filter(
      (player) => player.displayName === bru.getEnvVar('thirdDisplayName'),
    );
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().pendingInvitees).to.have.lengthOf(0);
    expect(res.getBody().players).to.have.lengthOf(1);
    expect(legolasMemberships).to.have.lengthOf(0);
    expect(res.getBody().revision).to.equal(1);
  });
}
