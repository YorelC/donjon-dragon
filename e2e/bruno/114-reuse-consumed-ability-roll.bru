meta {
  name: 114 - Reuse consumed ability roll
  type: http
  seq: 114
}

post {
  url: {{baseUrl}}/campaigns/{{rollCampaignId}}/characters
  body: json
  auth: none
}

headers {
  content-type: application/json
  x-csrf-token: {{csrfToken}}
  Idempotency-Key: {{$randomUUID}}
}

body:json {
  {
    "name": "Second tire E2E",
    "alignment": "neutralGood",
    "age": 33,
    "heightCm": 105,
    "weightKg": 18,
    "description": "Un voyageur prudent aux yeux vifs.",
    "speciesKey": "halfling",
    "lineageKey": null,
    "size": "Small",
    "standardLanguages": ["elvish", "dwarvish"],
    "classKey": "rogue",
    "backgroundKey": "charlatan",
    "base": {{abilityRollBase}},
    "backgroundBonuses": { "dexterity": 2, "charisma": 1 },
    "choices": [
      {
        "source": { "type": "class", "key": "rogue" },
        "skills": ["acrobatics", "insight", "perception", "stealth"],
        "expertise": ["stealth", "perception"],
        "languages": ["gnomish"],
        "weaponMasteries": ["dagger", "shortbow"]
      },
      {
        "source": { "type": "feat", "key": "skilled" },
        "skills": ["arcana", "history", "medicine"]
      }
    ],
    "equipment": {
      "armorKey": null,
      "shield": false,
      "items": [],
      "gold": 0,
      "classOptionId": "B",
      "backgroundOptionId": "B"
    },
    "abilityMethod": "roll",
    "abilityRollId": "{{abilityRollId}}"
  }
}

tests {
  test('refuse un tirage deja consomme', function() {
    expect(res.getStatus()).to.equal(400);
  });
}
