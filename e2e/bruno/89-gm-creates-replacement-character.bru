meta {
  name: 89 - GM creates replacement character
  type: http
  seq: 89
}

post {
  url: {{baseUrl}}/campaigns/{{campaignId}}/characters
  body: json
  auth: none
}

headers {
  content-type: application/json
  x-csrf-token: {{csrfToken}}
}

body:json {
  {
    "name": "Remplaçant E2E",
    "speciesKey": "halfling",
    "lineageKey": null,
    "classKey": "rogue",
    "backgroundKey": "charlatan",
    "abilityMethod": "roll",
    "base": { "strength": 8, "dexterity": 15, "constitution": 13, "intelligence": 12, "wisdom": 10, "charisma": 14 },
    "backgroundBonuses": { "dexterity": 2, "charisma": 1 },
    "choices": [
      {
        "source": { "type": "class", "key": "rogue" },
        "skills": ["acrobatics", "insight", "perception", "stealth"],
        "expertise": ["stealth", "perception"]
      }
    ],
    "equipment": {
      "armorKey": "leather", "shield": false,
      "items": [{ "itemKey": "leather", "quantity": 1 }, { "itemKey": "dagger", "quantity": 2 }],
      "gold": 8, "classOptionId": "A", "backgroundOptionId": "A"
    },
    "abilityRoll": {
      "dice": [[6,5,4,1],[6,4,4,2],[5,4,4,3],[4,4,4,1],[4,3,3,2],[3,3,2,1]],
      "totals": [15,14,13,12,10,8]
    }
  }
}

script:post-response {
  bru.setVar('replacementCharacterId', res.getBody().id);
  bru.setVar('replacementRevision', res.getBody().revision);
}

tests {
  test('crée le personnage entrant dans le vivier', function() {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().assignedTo).to.equal(null);
  });
}
