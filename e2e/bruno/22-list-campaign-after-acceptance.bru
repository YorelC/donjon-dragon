meta {
  name: 22 - List campaign after acceptance
  type: http
  seq: 22
}

get {
  url: {{baseUrl}}/campaigns
  body: none
  auth: none
}

tests {
  test('rend la campagne une seule fois comme campagne active', function() {
    const matches = res.getBody().filter(
      (item) => item.id === bru.getVar('campaignId'),
    );
    expect(res.getStatus()).to.equal(200);
    expect(matches).to.have.lengthOf(1);
    expect(matches[0].myRole).to.equal('player');
  });
}
