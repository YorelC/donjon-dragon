}

body:json {
  {
    "email": "{{inviteeEmail}}",
    "password": "{{inviteePassword}}"
  }
}

script:post-response {
  bru.setVar('csrfToken', bru.cookies.get('csrf_token'));
}

tests {
  test('rouvre la session du membre rétrogradé', function() {
    expect(res.getStatus()).to.equal(201);
  });
}
