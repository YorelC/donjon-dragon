meta {
  name: 09 - Create campaign
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/campaigns
  body: json
  auth: none
}

headers {
  content-type: application/json
  x-csrf-token: {{csrfToken}}
  Idempotency-Key: {{creationKey}}
}

body:json {
  {
    "name": "{{campaignName}}"
  }
}

script:post-response {
  bru.setVar('campaignId', res.getBody().id);
}

tests {
  test('crée la campagne et son premier MJ', function() {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().isOwner).to.equal(true);
    expect(res.getBody().gameMasterCount).to.equal(1);
    expect(res.getBody().playerCount).to.equal(0);
  });
}
