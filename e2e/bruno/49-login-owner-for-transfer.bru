meta {
  name: 49 - Login owner for transfer
  type: http
  seq: 49
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "email": "{{ownerEmail}}",
    "password": "{{ownerPassword}}"
  }
}

script:post-response {
  bru.setVar('csrfToken', bru.cookies.get('csrf_token'));
}

tests {
  test('rouvre la session du propriétaire pour transférer', function() {
    expect(res.getStatus()).to.equal(201);
  });
}
