meta {
  name: 77 - Demote owner before last GM check
  type: http
  seq: 77
}

post {
  url: {{baseUrl}}/campaigns/{{campaignId}}/members/{{thirdDisplayName}}/demote
  body: json
  auth: none
}

headers {
  content-type: application/json
  x-csrf-token: {{csrfToken}}
  Idempotency-Key: {{demoteLegolasKey}}
}

body:json {
  { "expectedRevision": {{campaignRevision}} }
}

script:post-response {
  bru.setVar('campaignRevision', res.getBody().revision);
}

tests {
  test('rend Gandalf seul MJ tout en gardant Legolas propriétaire', function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().revision).to.equal(12);
    expect(res.getBody().actor.isOwner).to.equal(true);
    expect(res.getBody().target.role).to.equal('player');
  });
}
