meta {
  name: 34 - Assign character to Frodo
  type: http
  seq: 34
}

post {
  url: {{baseUrl}}/campaigns/{{campaignId}}/characters/{{characterId}}/assign
  body: json
  auth: none
}

headers {
  content-type: application/json
  x-csrf-token: {{csrfToken}}
}

body:json {
  { "playerDisplayName": "{{inviteeDisplayName}}" }
}

tests {
  test('attribue le personnage au joueur avant promotion', function() {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().assignedTo.displayName).to.equal(
      bru.getEnvVar('inviteeDisplayName'),
    );
  });
}
