  body: json
  auth: none
}

headers {
  content-type: application/json
  x-csrf-token: {{csrfToken}}
  Idempotency-Key: {{firstInviteKey}}
}

body:json {
  {
    "displayName": "{{inviteeDisplayName}}"
  }
}

tests {
