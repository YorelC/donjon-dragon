meta {
  name: 103 - Demote player for immediate permission
  type: http
  seq: 103
}

post {
  url: {{baseUrl}}/campaigns/{{campaignId}}/members/{{ownerDisplayName}}/demote
  body: json
  auth: none
}

headers {
  content-type: application/json
  x-csrf-token: {{csrfToken}}
  idempotency-key: {{$randomUUID}}
}

body:json {
  { "expectedRevision": {{spec007CampaignRevision}} }
}

tests {
  test('rétrograde immédiatement le co-MJ', function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().target.role).to.equal('player');
  });
}
