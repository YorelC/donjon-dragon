meta {
  name: 01 - Login owner
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "email": "{{ownerEmail}}",
    "password": "{{ownerPassword}}"
  }
}

script:post-response {
  bru.setVar('csrfToken', bru.cookies.get('csrf_token'));
}

tests {
  test('ouvre la session du propriétaire', function() {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().user.email).to.equal(bru.getEnvVar('ownerEmail'));
  });
}
