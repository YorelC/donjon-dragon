meta {
  name: 05 - Reject divergent replay
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/campaigns
  body: json
  auth: none
}

headers {
  content-type: application/json
  x-csrf-token: {{csrfToken}}
  Idempotency-Key: {{idempotencyKey}}
}

body:json {
  {
    "name": "{{divergentCampaignName}}"
  }
}

tests {
  test('signale le conflit sans accepter une autre intention', function() {
    expect(res.getStatus()).to.equal(409);
  });
}
