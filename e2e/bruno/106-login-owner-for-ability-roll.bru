meta {
  name: 106 - Login owner for ability roll suite
  type: http
  seq: 106
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "email": "{{ownerEmail}}",
    "password": "{{ownerPassword}}"
  }
}

script:post-response {
  bru.setVar('csrfToken', bru.cookies.get('csrf_token'));
}

tests {
  test('ouvre une session pour la suite du tirage', function() {
    expect(res.getStatus()).to.equal(201);
  });
}
