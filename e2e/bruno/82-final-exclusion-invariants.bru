meta {
  name: 82 - Final exclusion invariants
  type: http
  seq: 82
}

get {
  url: {{baseUrl}}/campaigns/{{campaignId}}
  body: none
  auth: none
}

tests {
  test('conserve uniquement le propriétaire MJ actif', function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().revision).to.equal(14);
    expect(res.getBody().owner.displayName).to.equal(
      bru.getEnvVar('thirdDisplayName'),
    );
    expect(res.getBody().gameMasters).to.have.length(1);
    expect(res.getBody().gameMasters[0].displayName).to.equal(
      bru.getEnvVar('thirdDisplayName'),
    );
    expect(res.getBody().players).to.have.length(0);
  });
}
