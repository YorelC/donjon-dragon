meta {
  name: 12 - Reject divergent invitation replay
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/campaigns/{{campaignId}}/invitations
  body: json
  auth: none
}

headers {
  content-type: application/json
  x-csrf-token: {{csrfToken}}
  Idempotency-Key: {{firstInviteKey}}
}

body:json {
  {
    "displayName": "{{thirdDisplayName}}"
  }
}

tests {
  test('refuse une autre intention sous la même clé', function() {
    expect(res.getStatus()).to.equal(409);
  });
}
