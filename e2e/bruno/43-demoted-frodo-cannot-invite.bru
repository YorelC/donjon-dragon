meta {
  name: 43 - Demoted Frodo cannot invite
  type: http
  seq: 43
}

post {
  url: {{baseUrl}}/campaigns/{{campaignId}}/invitations
  body: json
  auth: none
}

headers {
  content-type: application/json
  x-csrf-token: {{csrfToken}}
  Idempotency-Key: {{forbiddenInviteKey}}
}

body:json {
  { "displayName": "{{thirdDisplayName}}" }
}

tests {
  test('retire immédiatement les permissions de MJ', function() {
    expect(res.getStatus()).to.equal(403);
  });
}
