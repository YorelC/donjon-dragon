meta {
  name: 70 - Invite Gandalf after departure
  type: http
  seq: 70
}

post {
  url: {{baseUrl}}/campaigns/{{campaignId}}/invitations
  body: json
  auth: none
}

headers {
  content-type: application/json
  x-csrf-token: {{csrfToken}}
  Idempotency-Key: {{inviteGandalfKey}}
}

body:json {
  { "displayName": "{{ownerDisplayName}}" }
}

tests {
  test('réinvite l ancien propriétaire comme joueur', function() {
    expect(res.getStatus()).to.equal(204);
  });
}
