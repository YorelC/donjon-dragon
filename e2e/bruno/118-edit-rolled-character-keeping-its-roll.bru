meta {
  name: 118 - Edit rolled character keeping its roll
  type: http
  seq: 118
}

put {
  url: {{baseUrl}}/campaigns/{{rollCampaignId}}/characters/{{rolledCharacterId}}
  body: json
  auth: none
}

headers {
  content-type: application/json
  x-csrf-token: {{csrfToken}}
}

body:json {
  {
    "name": "Tire aux des E2E corrige",
    "alignment": "neutralGood",
    "age": 33,
    "heightCm": 90,
    "weightKg": 18,
    "description": "Un voyageur prudent aux yeux vifs.",
    "speciesKey": "halfling",
    "lineageKey": null,
    "standardLanguages": ["elvish", "dwarvish"],
    "classKey": "rogue",
    "backgroundKey": "charlatan",
    "base": {{abilityRollBase}},
    "backgroundBonuses": { "dexterity": 2, "charisma": 1 },
    "choices": [
      {
        "source": { "type": "class", "key": "rogue" },
        "skills": ["acrobatics", "insight", "perception", "stealth"],
        "expertise": ["stealth", "perception"],
        "languages": ["gnomish"],
        "weaponMasteries": ["dagger", "shortbow"]
      },
      {
        "source": { "type": "feat", "key": "skilled" },
        "skills": ["arcana", "history", "medicine"]
      }
    ],
    "equipment": {
      "armorKey": null,
      "shield": false,
      "items": [],
      "gold": 0,
      "classOptionId": "B",
      "backgroundOptionId": "B"
    },
    "abilityMethod": "roll",
    "abilityRollId": null
  }
}

tests {
  test('laisse editer un personnage tire aux des', function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().name).to.equal('Tire aux des E2E corrige');
  });
}
