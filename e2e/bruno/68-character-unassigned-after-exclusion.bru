meta {
  name: 68 - Character unassigned after exclusion
  type: http
  seq: 68
}

get {
  url: {{baseUrl}}/campaigns/{{campaignId}}/characters
  body: none
  auth: none
}

tests {
  test('conserve le personnage exclu dans le vivier', function() {
    const character = res.getBody().find(
      (item) => item.id === bru.getVar('characterId'),
    );
    expect(res.getStatus()).to.equal(200);
    expect(character.assignmentStatus).to.equal('available');
  });
}
