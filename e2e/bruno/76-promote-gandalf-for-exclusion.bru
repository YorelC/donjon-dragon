meta {
  name: 76 - Promote Gandalf for exclusion
  type: http
  seq: 76
}

post {
  url: {{baseUrl}}/campaigns/{{campaignId}}/members/{{ownerDisplayName}}/promote
  body: json
  auth: none
}

headers {
  content-type: application/json
  x-csrf-token: {{csrfToken}}
  Idempotency-Key: {{promoteGandalfKey}}
}

body:json {
  { "expectedRevision": {{campaignRevision}} }
}

script:post-response {
  bru.setVar('campaignRevision', res.getBody().revision);
}

tests {
  test('prépare un co-MJ à exclure directement', function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().revision).to.equal(11);
    expect(res.getBody().target.role).to.equal('gameMaster');
  });
}
