meta {
  name: 79 - Promote owner again
  type: http
  seq: 79
}

post {
  url: {{baseUrl}}/campaigns/{{campaignId}}/members/{{thirdDisplayName}}/promote
  body: json
  auth: none
}

headers {
  content-type: application/json
  x-csrf-token: {{csrfToken}}
  Idempotency-Key: {{promoteLegolasAgainKey}}
}

body:json {
  { "expectedRevision": {{campaignRevision}} }
}

script:post-response {
  bru.setVar('campaignRevision', res.getBody().revision);
}

tests {
  test('rétablit un second MJ avant exclusion', function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().revision).to.equal(13);
    expect(res.getBody().target.role).to.equal('gameMaster');
  });
}
