meta {
  name: 54 - Detail as new owner
  type: http
  seq: 54
}

get {
  url: {{baseUrl}}/campaigns/{{campaignId}}
  body: none
  auth: none
}

tests {
  test('applique immédiatement le transfert de propriété', function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().isOwner).to.equal(true);
    expect(res.getBody().owner.displayName).to.equal(
      bru.getEnvVar('thirdDisplayName'),
    );
  });
}
