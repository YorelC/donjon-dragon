{
  "name": "donjon-dragon",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint && pnpm lint:rules",
    "lint:rules": "node scripts/check-rules-coverage.mjs",
    "test": "pnpm -r test",
    "test:e2e:api": "node scripts/run-e2e-api.mjs",
    "e2e:clean": "node scripts/drop-e2e-databases.mjs",
    "seed": "pnpm --filter back seed",
    "seed:items": "pnpm --filter back seed:items",
    "seed:monsters": "pnpm --filter back seed:monsters"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@usebruno/cli": "4.0.0",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "typescript-eslint": "^8.65.0"
  }
}
